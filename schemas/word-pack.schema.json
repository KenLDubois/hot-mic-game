{
  "title": "Hot Mic word pack",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "words"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "words": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 40
          },
          "difficulty": {
            "type": "string",
            "enum": [
              "easy",
              "medium",
              "hard"
            ]
          }
        },
        "required": [
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 5000
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "name",
    "words"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
