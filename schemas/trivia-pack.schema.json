{
  "title": "Hot Mic trivia pack",
  "type": "object",
  "properties": {
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "type": {
      "type": "string",
      "const": "trivia"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 60
    },
    "questions": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 240
          },
          "choices": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 100
            },
            "minItems": 2,
            "maxItems": 4
          },
          "answer": {
            "type": "integer",
            "minimum": 0
          },
          "source": {
            "type": "string",
            "maxLength": 500,
            "pattern": "^https?:\\/\\/\\S+$"
          },
          "unconfirmed": {
            "type": "boolean"
          }
        },
        "required": [
          "question",
          "choices",
          "answer"
        ],
        "additionalProperties": false
      },
      "minItems": 1,
      "maxItems": 2000
    }
  },
  "required": [
    "schemaVersion",
    "type",
    "name",
    "questions"
  ],
  "additionalProperties": false,
  "$schema": "http://json-schema.org/draft-07/schema#"
}
